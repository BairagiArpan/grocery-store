rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Replace ADMIN_UID_HERE with the store owner's Firebase Auth UID.
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'ADMIN_UID_HERE';
    }
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /branding/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
